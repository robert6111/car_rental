<?xml version="1.0" encoding="UTF-8"?>
<!--
  Car Rental - rules for IIS (Windows Server). Apache ignores this file and uses .htaccess.
  Blocks the private folders and files from the web. PHP must be set up in IIS (FastCGI).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config" />
          <add segment="storage" />
          <add segment="vendor" />
          <add segment="cron" />
          <add segment="database" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".txt" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".example" allowed="false" />
          <add fileExtension=".gitignore" allowed="false" />
          <add fileExtension=".htaccess" allowed="false" />
        </fileExtensions>
        <!-- Allow uploads up to 12 MB (documents are limited to 10 MB by the system). -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
